# Copy to .env and adjust. Never commit the real .env (it holds the token).

# --- Hugging Face (private model bundle) ---
# A READ-only token. Required at runtime to download the private bundle.
HF_TOKEN=hf_xxx_read_only_token

# --- Model source ---
SCGNN_REPO_ID=Signeemmanuel/scgnn-smartcontract
# Default tracks the 'production' tag, which you re-point when a checkpoint is
# ready. For the viva, freeze to the exact bundle SHA:
#   SCGNN_REVISION=5f87610c80520e56935d789d95e4b370216d5423
SCGNN_REVISION=production
SCGNN_DEVICE=cpu

# --- Decision policy (the reported one) ---
SCGNN_THRESHOLD=0.5

# --- Limits / robustness ---
SCGNN_MAX_UPLOAD_BYTES=262144
SCGNN_ANALYZE_TIMEOUT_S=120
SCGNN_MAX_WORKERS=1
SCGNN_QUEUE_MAX=32

# --- CORS (the scgnn-web origin) ---
# Comma-separated. Empty disables CORS. Example for local Vite dev:
SCGNN_CORS_ORIGINS=http://localhost:5173
